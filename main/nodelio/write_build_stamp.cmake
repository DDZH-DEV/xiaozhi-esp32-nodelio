# 顶栏版本：VYYYYMMDDNNN（NNN = 当天第几次编译，001 起）。
# 无 -DBUMP=1：configure 时确保头文件存在；同日已有序号则不改（避免无谓重编）。
# 有 -DBUMP=1：每次 idf.py build 的 custom target 递增序号。
if(NOT DEFINED OUT OR OUT STREQUAL "")
    message(FATAL_ERROR "write_build_stamp.cmake: OUT is required")
endif()

string(TIMESTAMP DAY "%Y%m%d")
set(SEQ 0)
set(HAVE_TODAY FALSE)
if(EXISTS "${OUT}")
    file(READ "${OUT}" OLD)
    if(OLD MATCHES "NL_BUILD_STAMP \"V${DAY}([0-9][0-9][0-9])\"")
        set(RAW "${CMAKE_MATCH_1}")
        string(REGEX REPLACE "^0+" "" RAW "${RAW}")
        if(RAW STREQUAL "")
            set(RAW 0)
        endif()
        set(SEQ "${RAW}")
        set(HAVE_TODAY TRUE)
    elseif(OLD MATCHES "NL_BUILD_STAMP \"V${DAY}\"")
        set(SEQ 0)
        set(HAVE_TODAY TRUE)
    endif()
endif()

if(DEFINED BUMP AND BUMP)
    if(HAVE_TODAY)
        math(EXPR SEQ "${SEQ} + 1")
    else()
        set(SEQ 1)
    endif()
else()
    if(HAVE_TODAY AND SEQ GREATER 0)
        return()
    endif()
    set(SEQ 1)
endif()

if(SEQ GREATER 999)
    set(SEQ 999)
endif()
if(SEQ LESS 10)
    set(SEQ_PAD "00${SEQ}")
elseif(SEQ LESS 100)
    set(SEQ_PAD "0${SEQ}")
else()
    set(SEQ_PAD "${SEQ}")
endif()

set(CONTENT "#define NL_BUILD_STAMP \"V${DAY}${SEQ_PAD}\"\n")
file(WRITE "${OUT}" "${CONTENT}")
message(STATUS "NL_BUILD_STAMP=V${DAY}${SEQ_PAD}")
