{
  "schema_version": 1,
  "app_id": "dsh.answer",
  "version": "1.0.0",
  "name": "DSH 确认",
  "description": "内部动作：allow/deny/cancel（cancel 与 deny 会 interrupt 本轮）、或 submit(qid+oid)。须带 session + notice_id；不要从应用列表打开。",
  "publisher": {
    "name": "NodeLio",
    "contact": "https://github.com/DDZH-DEV/nodelio-protocol/issues"
  },
  "categories": ["tool"],
  "min_protocol": 1,
  "requires": ["content.text", "action.invoke", "net.http_via_server"],
  "optional": ["content.list", "content.error", "content.action"],
  "surfaces": ["card"],
  "fallback": { "card_type": "plain_result" },
  "input_schema": {
    "type": "object",
    "properties": {
      "session": {
        "type": "string",
        "title": "任务 ID",
        "description": "待确认任务的外部会话 ID，由 dsh.status 返回。",
        "minLength": 1,
        "maxLength": 128,
        "ui_hint": "text"
      },
      "notice_id": {
        "type": "string",
        "title": "待确认项 ID",
        "description": "由 dsh.status 的待确认列表返回。",
        "minLength": 1,
        "maxLength": 128,
        "ui_hint": "text"
      },
      "action": {
        "type": "string",
        "title": "决定",
        "enum": ["allow", "deny", "submit", "cancel"],
        "default": "allow",
        "ui_hint": "select"
      },
      "qid": {
        "type": "string",
        "title": "问题 ID",
        "description": "action=submit 时：input_request 的 question id",
        "maxLength": 32,
        "ui_hint": "text"
      },
      "oid": {
        "type": "string",
        "title": "选项 ID",
        "description": "action=submit 时：option id（如 o_0）",
        "maxLength": 16,
        "ui_hint": "text"
      }
    },
    "required": ["session", "notice_id"]
  },
  "invoke": {
    "method": "POST",
    "timeout_ms": 8000,
    "transport": "outbound_bridge",
    "url": "http://127.0.0.1:8790/nodelio/dsh/answer",
    "result_types": ["plain_result", "error"],
    "default_display": {
      "card_type": "plain_result",
      "preferred_surface": "card",
      "density": "compact",
      "max_items": 1
    }
  },
  "expose_mcp": true,
  "mcp": {
    "name": "dsh.answer",
    "description": "Approve or deny a pending DSH task interaction"
  },
  "ui": {
    "entry_title": "DSH 确认",
    "entry_icon": "check"
  }
}
