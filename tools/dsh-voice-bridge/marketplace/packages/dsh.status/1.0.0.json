{
  "schema_version": 1,
  "app_id": "dsh.status",
  "version": "1.0.0",
  "name": "DSH 进度",
  "description": "查询 DSH 任务进度：顶栏横滑工作区 + 当前区会话列表；可指定 workspace/session。返回 list + spoken。",
  "publisher": {
    "name": "NodeLio",
    "contact": "https://github.com/DDZH-DEV/nodelio-protocol/issues"
  },
  "categories": ["tool"],
  "min_protocol": 1,
  "requires": ["content.list", "action.invoke", "net.http_via_server"],
  "optional": ["content.text", "content.error", "content.action"],
  "surfaces": ["card", "home_tile", "voice_reply"],
  "fallback": { "card_type": "plain_result" },
  "config_schema": {
    "type": "object",
    "properties": {
      "detail_tts": {
        "type": "string",
        "title": "详情页语音播报",
        "enum": ["0", "1"],
        "default": "0",
        "description": "打开会话详情时是否合成并播放末轮回复；关闭可避免详情轮询时桥端反复 TTS 卡顿。默认关闭。"
      }
    },
    "required": []
  },
  "input_schema": {
    "type": "object",
    "properties": {
      "workspace": {
        "type": "string",
        "title": "工作区路径",
        "description": "留空则自动选默认/有会话的工作区；顶栏仍列出全部供切换。",
        "maxLength": 260,
        "ui_hint": "text"
      },
      "session": {
        "type": "string",
        "title": "任务 ID 或标题片段",
        "description": "留空则列出该工作区的全部任务。",
        "maxLength": 128,
        "ui_hint": "text"
      }
    },
    "required": []
  },
  "invoke": {
    "method": "GET",
    "timeout_ms": 8000,
    "transport": "outbound_bridge",
    "url": "http://127.0.0.1:8790/nodelio/dsh/status",
    "result_types": ["list", "plain_result", "error"],
    "default_display": {
      "card_type": "list",
      "preferred_surface": "card",
      "density": "normal",
      "max_items": 5
    }
  },
  "expose_mcp": true,
  "mcp": {
    "name": "dsh.status",
    "description": "Query DSH task progress by workspace or session"
  },
  "ui": {
    "entry_title": "DSH 进度",
    "entry_icon": "activity"
  }
}
